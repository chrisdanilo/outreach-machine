 "autoResize": true, "lineHeight": 1.25}, {"id": "t155", "type": "text", "x": 582.0, "y": 2313, "width": 991, "height": 87, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["PHASE 2  -  DISCOVER"], "frameId": null, "roundness": null, "seed": 66067465, "version": 1, "versionNonce": 1677082678, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Find organizations and events we do not know yet. The program picks the sources that are due\n(directories, conference calendars, keynote speakers' pages, partner pages) and gives each AI helper\na batch with an exact search allowance. Helpers read the web in parallel and follow each find outward.\nThe program checks every result before it counts.", "fontSize": 17, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Find organizations and events we do not know yet. The program picks the sources that are due\n(directories, conference calendars, keynote speakers' pages, partner pages) and gives each AI helper\na batch with an exact search allowance. Helpers read the web in parallel and follow each find outward.\nThe program checks every result before it counts.", "autoResize": true, "lineHeight": 1.25}, {"id": "r156", "type": "rectangle", "x": 576.0, "y": 2415, "width": 948, "height": 56, "angle": 0, "strokeColor": "#15803D", "backgroundColor": "#FFFFFF", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 85, "groupIds": ["PHASE 2  -  DISCOVER"], "frameId": null, "roundness": {"type": 3}, "seed": 792882917, "version": 1, "versionNonce": 1800521052, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "t157", "type": "text", "x": 590.0, "y": 2422, "width": 868, "height": 39, "angle": 0, "strokeColor": "#6B6B6B", "backgroundColor": 