": 1782199384, "isDeleted": false, "boundElements": [{"id": "b1a8de58d31847ad9f67", "type": "text"}], "updated": 1, "link": null, "locked": false}, {"id": "b1a8de58d31847ad9f67", "type": "text", "x": 1469.1, "y": 4215.125, "width": 19.8, "height": 13.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["PHASE 7 (7 AM half)  -  THE SEND"], "frameId": null, "roundness": null, "seed": 1, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "GO?", "fontSize": 11, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "d216", "originalText": "GO?", "autoResize": true, "lineHeight": 1.25}, {"id": "t217", "type": "text", "x": 582.0, "y": 4254, "width": 1019, "height": 87, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["PHASE 7 (7 AM half)  -  THE SEND"], "frameId": null, "roundness": null, "seed": 1766704582, "version": 1, "versionNonce": 121192986, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "A SEPARATE scheduled task: fires 6:52 AM ET, waits until 7:00, then sends Emails 2 and 3 - only the\nrows on the approved list, exactly as listed, each thread re-read live first (a read older than 3 minutes\nis stale). Anything that changed overnight is skipped and left for tonight's run to decide again.\nBounce rate over 3% stops everything. The only task allowed to act without asking.", "fontSize": 17, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "A SEPARATE scheduled task: fires 6:52 AM ET, waits until 7:00, then sends Emails 2 and 3 - only the\nrows on the approved list, exactly as listed, each thread re-read live first (a read older than 3 minutes\nis stale). Anything that changed overnight is skipped and left for tonight's run to decide again.\nBounce rate over 3% stops everything. The only task allowed to act without asking.", "autoResize": true, "lineHeight": 1.25}, {"id": "r218", "type": "rectangle", "x": 576.0, "y": 4356, "width": 948, "height": 56, "angle": 0, "strokeColor": "#B91C1C", "backgroundColor": "#FFFFFF", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 85, "groupIds": ["PHASE 7 (7 AM half)  -  THE SEND"], "frameId": null, "roundness": {"type": 3}, "seed": 16874913, "version": 1, "versionNonce": 1556542619, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "t219", "type": "text", "x": 590.0, "y": 4363, "width": 851, "height": 39, "angle": 0, "strokeColor": "#6B6B6B", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["PHASE 7 (7 AM half)  -  THE SEND"], "frameId": null, "roundness": null, "seed": 860800, "version": 1, "versionNonce": 1698596981, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "reads: today's FINAL approved list, each thread live in Gmail, the templates, its own past sends (a\nduplicate = full stop) -> writes: sent emails + moved labels in Gmail, the send record", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "reads: today's FINAL approved list, each thread live in Gmail, the templates, its own past sends (a\nduplicate = full stop) -> writes: sent emails + moved labels in Gmail, the send record", "autoResize": true, "lineHeight": 1.25}, {"id": "a220", "type": "arrow", "x": 1050.0, "y": 4430, "width": 0, "height": 90, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughne