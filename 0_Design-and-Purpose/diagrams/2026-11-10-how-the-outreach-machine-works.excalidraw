, "version": 1, "versionNonce": 1622919687, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "t227", "type": "text", "x": 590.0, "y": 4695, "width": 876, "height": 39, "angle": 0, "strokeColor": "#6B6B6B", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["CHRIS  -  EACH MORNING"], "frameId": null, "roundness": null, "seed": 1701218420, "version": 1, "versionNonce": 519973814, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "reads: the morning report, the dossier beside Gmail Drafts, replies and flags -> writes: Email 1 sent,\nreplies, rulings (tonight's run reads them all)", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "reads: the morning report, the dossier beside Gmail Drafts, replies and flags -> writes: Email 1 sent,\nreplies, rulings (tonight's run reads them all)", "autoResize": true, "lineHeight": 1.25}, {"id": "a228", "type": "arrow", "x": 560.0, "y": 4641.0, "width": 0.0, "height": -3371.0, "angle": 0, "strokeColor": "#6B6B6B", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": ["cycle"], "frameId": null, "roundness": null, "seed": 431641993, "version": 1, "versionNonce": 1161325825, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "points": [[0, 0], [-430.0, 0], [-430.0, -3371.0], [0.0, -3371.0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "t229", "type": "text", "x": 560.0, "y": 4782, "width": 960, "height": 39, "angle": 0, "strokeColor": "#6B6B6B", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["cycle"], "frameId": null, "roundness": null, "seed": 1623775984, "version": 1, "versionNonce": 596811091, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "THE CYCLE (dashed line): what Chris sends and what people reply lands in Gmail. Tonight's run reads Gmail first,\nso every morning's actions are in the records by the next night. Nothing is re-done: the ledgers remember.", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "THE CYCLE (dashed line): what Chris sends and what people reply lands in Gmail. Tonight's run reads Gmail first,\nso every morning's actions are in the records by the next night. Nothing is re-done: the ledgers remember.", "autoResize": true, "lineHeight": 1.25}, {"id": "r230", "type": "rectangle", "x": 100, "y": 4922, "width": 1900, "height": 300, "angle": 0, "strokeColor": "#C9C2B0", "backgroundColor": "#F5F1E8", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["3-sequence"], "frameId": null, "roundness": {"type": 3}, "seed": 717052716, "version": 1, "versionNonce": 1571899993, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "t231", "type": "text", "x": 120, "y": 4940, "width": 1256, "height": 32, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["3-sequence"], "frameId": null, "roundness": null, "seed": 1271935745, "version": 1, "versionNonce": 1530055894, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "3 - THE EMAIL SEQUENCE  -  same for every machine, one thread per organization, 7 days apart", "fontSize": 24, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "3 - THE EMAIL SEQUENCE  -  same for every machine, one thread per organization, 7 days apart", "autoResize": true, "lineHeight": 1.25}, {"id": "e232", "type": "ellipse", "x": 120.0, "y": 5032, "width": 18.0, "height": 18.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#FFDE59", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["3-sequence"], "frameId": null, "roundness": null, "seed": 1908179212, "version": 1, "versionNonce": 862528907, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "r233", "type": "rectangle", "x": 116.0, "y": 5052.0, "width": 26.0, "height": 18.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#FFDE59", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["3-sequence"], "frameId": null, "roundness": {"type": 3}, "seed": 558023484, "version": 1, "versionNonce": 310020301, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "r234", "type": "rectangle", "x": 160, "y": 5002, "width": 360, "height": 120, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#FFDE59", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["3-sequence"], "frameId": null, "roundness": {"type": 3}, "seed": 1804976459, "version": 1, "versionNonce": 1943446232, "isDeleted": false, "boundElements": [{"id": "aa287b94ec904b68be3c", "type": "text"}], "updated": 1, "link": null, "locked": false}, {"id": "aa287b94ec904b68be3c", "type": "text", "x": 186.4, "y": 5032.0, "width": 307.2, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["3-sequence"], "frameId": null, "roundness": null, "seed": 1, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link":