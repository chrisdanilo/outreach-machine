Id": null, "roundness": null, "seed": 191158148, "version": 1, "versionNonce": 896376270, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "SUPPLY RUN  -  DISCOVER > QUALIFY > EVENTS > PEOPLE", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "SUPPLY RUN  -  DISCOVER > QUALIFY > EVENTS > PEOPLE", "autoResize": true, "lineHeight": 1.25}, {"id": "t217", "type": "text", "x": 582.0, "y": 4254, "width": 1048, "height": 87, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["SUPPLY RUN  -  DISCOVER > QUALIFY > EVENTS > PEOPLE"], "frameId": null, "roundness": null, "seed": 1315482090, "version": 1, "versionNonce": 1217159170, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "The same four research steps as the loop, run on their own clock so the night run never starts hungry:\nfind new organizations, judge their fit and owner, check their events, find and verify their people - up to\nthis run's caps, hard stop 4:30 AM. One run at a time: it yields if a night run is alive. Its only output is\na longer, better-stocked master list; drafting stays the night run's job, sending the 7 AM task's.", "fontSize": 17, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The same four research steps as the loop, run on their own clock so the night run never starts hungry:\nfind new organizations, judge their fit and owner, check their events, find and verify their people - up to\nthis run's caps, hard stop 4:30 AM. One run at a time: it yields if a night run is alive. Its only output is\na longer, better-stocked master list; drafting stays the night run's job, sending the 7 AM task's.", "autoResize": true, "lineHeight": 1.25}, {"id": "r218", "type": "rectangl