nNonce": 1802883218, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Only for machines still under their minimum. No clock. A pass that adds nothing for a machine = out of supply tonight. Runaway guard: 25 passes.", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Only for machines still under their minimum. No clock. A pass that adds nothing for a machine = out of supply tonight. Runaway guard: 25 passes.", "autoResize": true, "lineHeight": 1.25}, {"id": "r150", "type": "rectangle", "x": 560.0, "y": 2247, "width": 980, "height": 242, "angle": 0, "strokeColor": "#15803D", "backgroundColor": "#B2F2BB", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["PHASE 2  -  DISCOVER"], "frameId": null, "roundness": {"type": 3}, "seed": 10093594, "version": 1, "versionNonce": 318672044, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "r151", "type": "rectangle", "x": 578.0, "y": 2263, "width": 38.0, "height": 32.3, "angle": 0, "strokeColor": "#1A1A1A", "backgroundColor": "#1A1A1A", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["PHASE 2  -  DISCOVER"], "frameId": null, "roundness": {"type": 3}, "seed": 1508585325, "version": 1, "versionNonce": 654896913, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "t152", "type": "text", "x": 584.65, "y": 2269.65, "width": 43, "height": 19, "angle": 0, "strokeColor": "#FFDE59", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["PHASE 2  -  DISCOVER"], "frameId": null, "roundness": null, "seed": 1478555386, "version": 1, "versionNonce": 1930137516, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": fal