id": "b806bf61265d4c5b9880", "type": "text"}], "updated": 1, "link": null, "locked": false, "points": [[0, 0], [130, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "b806bf61265d4c5b9880", "type": "text", "x": 1603.0, "y": 5052.625, "width": 54.0, "height": 18.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["3-sequence"], "frameId": null, "roundness": null, "seed": 1, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "7 days", "fontSize": 15, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "a239", "originalText": "7 days", "autoResize": true, "lineHeight": 1.25}, {"id": "r240", "type": "rectangle", "x": 1630, "y": 5002, "width": 330, "height": 120, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#FAF6EA", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["3-sequence"], "frameId": null, "roundness": {"type": 3}, "seed": 1744287013, "version": 1, "versionNonce": 122514694, "isDeleted": false, "boundElements": [{"id": "7418a99e53d84a0f88e3", "type": "text"}], "updated": 1, "link": null, "locked": false}, {"id": "7418a99e53d84a0f88e3", "type": "text", "x": 1641.4, "y": 5032.0, "width": 307.2, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["3-sequence"], "frameId": null, "roundness": null, "seed": 1, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "CLOSED\nno reply 7 days after Email 3;\nnever started again by a machine", "fontSize": 16, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "r240", "originalText": "CLOSED\nno reply 7 days after Email 3;\nnever started again by a machine", "autoResize": true, "lineHeight": 1.25}, {"id": "t241", "type": "text", "x": 120, "y": 5162, "width": 1632, "height": 20, "angle": 0, "strokeColor": "#6B6B6B", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["3-sequence"], "frameId": null, "roundness": null, "seed": 1739968895, "version": 1, "versionNonce": 1107747776, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Any real reply stops the sequence and goes to Chris  -  an auto-reply is never a reply  -  a bounce stops the thread  -  weekend or US holiday = delayed to the next business day, never skipped", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Any real reply stops the sequence and goes to Chris  -  an auto-reply is never a reply  -  a bounce stops the thread  -  weekend or US holiday = delayed to the next business day, never skipped", "autoResize": true, "lineHeight": 1.25}, {"id": "r242", "type": "rectangle", "x": 100, "y": 5272, "width": 1900, "height": 360, "angle": 0, "strokeColor": "#C9C2B0", "backgroundColor": "#F5F1E8", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["4-governs"], "frameId": null, "roundness": {"type": 3}, "seed": 1812078513, "version": 1, "versionNonce": 1520922084, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "t243", "type": "text", "x": 120, "y": 5290, "width": 382, "height": 32, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["4-governs"], "frameId": null, "roundness": null, "seed": 1006060153, "version": 1, "versionNonce": 138303758, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "4 - WHAT GOVERNS EVERY STEP", "fontSize": 24, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "4 - WHAT GOVERNS EVERY STEP", "autoResize": true, "lineHeight": 1.25}, {"id": "r244", "type": "rectangle", "x": 140, "y": 5342, "width": 586.6666666666666, "height": 250, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#FFDE59", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["4-governs"], "frameId": null, "roundness": {"type": 3}, "seed": 590586880, "version": 1, "versionNonce": 957474879, "isDeleted": false, "boundElements": [{"id": "4f31a52df47f4a5a8357", "type": "text"}], "updated": 1, "link": null, "locked": false}, {"id": "4f31a52df47f4a5a8357", "type": "text", "x": 275.8333333333333, "y": 5382.625, "width": 315.0, "height": 168.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["4-governs"], "frameId": null, "roundness": null, "seed": 1, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "THE 8 NON-NEGOTIABLES (the Charter)\n1. Email 1 is Chris's to send\n2. One thread per organization\n3. Do-not-contact is absolute\n4. Zero guessed addresses\n5. Email copy is frozen\n6. Gmail is the truth\n7. The night never sends\n8. Doesn't add up? Stop and hold", "fontSize": 15, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "r244", "originalText": "THE 8 NON-NEGOTIABLES (the Charter)\n1. Email 1 is Chris's to send\n2. One thread per organization\n3. Do-not-contact is absolute\n4. Zero guessed addresses\n5. Email copy is frozen\n6. Gmail is the truth\n7. The night never sends\n8. Doesn't add up? Stop and hold", "autoResize": true, "lineHeight": 1.25}, {"id": "r245", "type": "rectangle", "x": 756.6666666666666, "y": 5342, "width": 586.6666666666666, "height": 250, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#FFFFFF", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["4-governs"], "frameId": null, "roundness": {"type": 3}, "seed": 1185695790, "version": 1, "versionNonce": 342186243, "isDeleted": false, "boundElements": [{"id": "a17d9653f6444e7996a7", "type": "text"}], "updated": 1, "link": null, "locked": false}, {"id": "a17d9653f6444e7996a7", "type": "text", "x": 789.0, "y": 5392.0, "width": 522.0, "height": 150.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["4-governs"], "frameId": null, "roundness": null, "seed": 1, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "WHO DOES WHAT\nFIXED PROGRAMS (same answer every time):\nbookkeeping, routing, timing, address checks,\ntemplate filling, safety gates, 'the one next step'.\nAI HELPERS (judgment): read web pages, judge fit,\nfind people, sort replies, write the plain-English report.\nThe AI never writes email copy, never picks who\ngets emailed, and never sends anything.", "fontSize": 15, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "r245", "originalText": "WHO DOES WHAT\nFIXED PROGRAMS (same answer every time):\nbookkeeping, routing, timing, address checks,\ntemplate filling, safety gates, 'the one next step'.\nAI HELPERS (judgment): read web pages, judge fit,\nfind people, sort replies, write the plain-English report.\nThe AI never writes email copy, never picks who\ngets emailed, and never sends anything.", "autoResize": true, "lineHeight": 1.25}, {"id": "r246", "type": "rectangle", "x": 1373.3333333333333, "y": 5342, "width": 586.6666666666666, "height": 250, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#FFFFFF", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["4-governs"], "frameId": null, "roundness": {"type": 3}, "seed": 131663398, "version": 1, "versionNonce": 747748168, "isDeleted": false, "boundElements": [{"id": "40fcf06fc69440e9a343", "type": "text"}], "updated": 1, "link": null, "locked": false}, {"id": "40fcf06fc69440e9a343", "type": "text", "x": 1414.6666666666665, "y": 5392.0, "width": 504.0, "height": 150.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["4-governs"], "frameId": null, "roundness": null, "seed": 1, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "THE GUIDING DOCUMENTS\nCHARTER - why it exists, what it must never become\nRULEBOOK - the rules; changes only from Chris\nVOCABULARY - the words\nSETTINGS FILE - every number, one block per machine\nRULINGS LOG - questions for Chris, his answers\nCAPA LOG - what went wrong, the fix, the prevention\nIf a change does not trace to one of these, it is drift.", "fontSize": 15, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "r246", "originalText": "THE GUIDING DOCUMENTS\nCHARTER - why it exists, what it must never become\nRULEBOOK - the rules; changes only from Chris\nVOCABULARY - the words\nSETTINGS FILE - every number, one block per machine\nRULINGS LOG - questions for Chris, his answers\nCAPA LOG - what went wrong, the fix, the prevention\nIf a change does not trace to one of these, it is drift.", "autoResize": true, "lineHeight": 1.25}], "appState": {"viewBackgroundColor": "#ffffff", "gridSize": null}, "files": {}}