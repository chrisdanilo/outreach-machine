 "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "PHASE 4  -  PEOPLE", "autoResize": true, "lineHeight": 1.25}, {"id": "d175", "type": "diamond", "x": 1440.0, "y": 2900, "width": 78.0, "height": 44.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#FFDE59", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["PHASE 4  -  PEOPLE"], "frameId": null, "roundness": null, "seed": 667043558, "version": 1, "versionNonce": 40237128, "isDeleted": false, "boundElements": [{"id": "50d3583618384f7c86c2", "type": "text"}], "updated": 1, "link": null, "locked": false}, {"id": "50d3583618384f7c86c2", "type": "text", "x": 1455.9, "y": 2915.125, "width": 46.199999999999996, "height": 13.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["PHASE 4  -  PEOPLE"], "frameId": null, "roundness": null, "seed": 1, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "3 GATES", "fontSize": 11, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "d175", "originalText": "3 GATES", "autoResize": true, "lineHeight": 1.25}, {"id": "t176", "type": "text", "x": 582.0, "y": 2954, "width": 962, "height": 87, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["PHASE 4  -  PEOPLE"], "frameId": null, "roundness": null, "seed": 1091576635, "version": 1, "versionNonce": 756984270, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Find up to 4 people per org (1 To + 3 Cc), chosen by ROLE. An address counts only if it is printed\non the org's own page or auto-reply - OR a named person with no published address is looked up in\nApollo and counts only if Apollo says Verified AND ZeroBounce says valid AND it is on the org's own\ndomain. A general inbox is the To only after that lookup found nobody. Zero guesses, ever.", "fontSize": 17, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Find up to 4 people per org (1 To + 3 Cc), chosen by ROLE. An address counts only if it is printed\non the org's own page or auto-reply - OR a named person with no published address is looked up in\nApollo and counts only if Apollo says Verified AND ZeroBounce says valid AND it is on the org's own\ndomain. A general inbox is the To only after that lookup found nobody. Zero guesses, ever.", "autoResize": true, "lineHeight": 1.25}, {"id": "r177", "type": "rectangle", "x": 576.0, "y": 3056, "width": 948, "height": 56, "angle": 0, "strokeColor": "#6D28D9", "backgroundColor": "#FFFFFF", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 85, "groupIds": ["PHASE 4  -  PEOPLE"], "frameId": null, "roundness": {"type": 3}, "seed": 989968181, "version": 1, "versionNonce": 1260429351, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "t178", "type": "text", "x": 590.0, "y": 3063, "width": 885, "height": 39, "angle": 0, "strokeColor": "#6B6B6B", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["PHASE 4  -  PEOPLE"], "frameId": null, "roundness": null, "seed": 1444320860, "version": 1, "versionNonce": 522984203, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "reads: fit orgs with no thread yet, their staff pages, their auto-replies, Apollo -> writes: each org's\nrecipients + greeting, or why it is held", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": nul