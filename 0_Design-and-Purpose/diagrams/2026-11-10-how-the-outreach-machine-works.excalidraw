h": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["PHASE 7 (night half)  -  TOMORROW'S APPROVED SEND LIST"], "frameId": null, "roundness": null, "seed": 29785343, "version": 1, "versionNonce": 1786329438, "isDeleted": false, "boundElements": [{"id": "1ebb226af8ad4780a5b0", "type": "text"}], "updated": 1, "link": null, "locked": false}, {"id": "1ebb226af8ad4780a5b0", "type": "text", "x": 1465.8, "y": 1875.125, "width": 26.4, "height": 13.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["PHASE 7 (night half)  -  TOMORROW'S APPROVED SEND LIST"], "frameId": null, "roundness": null, "seed": 1, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "GATE", "fontSize": 11, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "d141", "originalText": "GATE", "autoResize": true, "lineHeight": 1.25}, {"id": "t142", "type": "text", "x": 582.0, "y": 1914, "width": 962, "height": 65, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["PHASE 7 (night half)  -  TOMORROW'S APPROVED SEND LIST"], "frameId": null, "roundness": null, "seed": 342664422, "version": 1, "versionNonce": 335901206, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "For every open thread: is Email 2 or 3 due? 7 days after the last send, business days only, delayed\npast weekends and holidays, never skipped. Stopped by any reply, stop label, open draft or bounce.\nEvery row must pass every Rulebook check. Anything flagged is NOT approved. Final once written.", "fontSize": 17, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "For every open thread: is Email 2 or 3 due? 7 days after the last send, business days only, delayed\npast weekends and holidays, never skipped. Stopped by any reply, stop label, open draft or bounce.\nEvery row must pass every Rulebook check. Anything flagged is NOT approved. Final once written.", "autoResize": true, "lineHeight": 1.25}, {"id": "r143", "type": "rectangle", "x": 576.0, "y": 1993, "width": 948, "height": 56, "angle": 0, "strokeColor": "#0F766E", "backgroundColor": "#FFFFFF", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 85, "groupIds": ["PHASE 7 (night half)  -  TOMORROW'S APPROVED SEND LIST"], "frameId": null, "roundness": {"type": 3}, "seed": 1337430455, "version": 1, "versionNonce": 1957247639, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "t144", "type": "text", "x": 590.0, "y": 2000, "width": 885, "height": 39, "angle": 0, "strokeColor": "#6B6B6B", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["PHASE 7 (night half)  -  TOMORROW'S APPROVED SEND LIST"], "frameId": null, "roundness": null, "seed": 36946641, "version": 1, "versionNonce": 195200337, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "reads: the master list, the 'every address ever contacted' ledger, the calendar -> writes: the approved\nsend list (read at 7 AM)", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "reads: the master list, the 'every address ever contacted' ledger, the calendar -> writes: the approved\nsend list (read at 7 AM)", "autoResize": true, "lineHeight": 1.25}, {"id": "a145", "type": "arrow", "x": 1050.0, "y": 2067, "width": 0, "height": 90, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "ro