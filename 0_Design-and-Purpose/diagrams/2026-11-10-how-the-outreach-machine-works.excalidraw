010, "height": 87, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["PHASE 1  -  TIDY GMAIL"], "frameId": null, "roundness": null, "seed": 1079728746, "version": 1, "versionNonce": 1196261294, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Three housekeeping jobs. (a) Stray Email 1 drafts with no label: rewrite, hand to the other\nmachine, or delete - never left for Chris. (b) Put one label on every thread: /0 drafted, /1 /2 /3 sent,\nstar replied, x closed, warning needs Chris, pause hold. (c) Threads Chris must see first get their\nnext email saved as a DRAFT reply, never sent.", "fontSize": 17, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Three housekeeping jobs. (a) Stray Email 1 drafts with no label: rewrite, hand to the other\nmachine, or delete - never left for Chris. (b) Put one label on every thread: /0 drafted, /1 /2 /3 sent,\nstar replied, x closed, warning needs Chris, pause hold. (c) Threads Chris must see first get their\nnext email saved as a DRAFT reply, never sent.", "autoResize": true, "lineHeight": 1.25}, {"id": "r134", "type": "rectangle", "x": 576.0, "y": 1684, "width": 948, "height": 56, "angle": 0, "strokeColor": "#1D4ED8", "backgroundColor": "#FFFFFF", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 85, "groupIds": ["PHASE 1  -  TIDY GMAIL"], "frameId": null, "roundness": {"type": 3}, "seed": 69354283, "version": 1, "versionNonce": 978003685, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "t135", "type": "text", "x": 590.0, "y": 1691, "width": 902, "height": 39, "angle": 0, "strokeColor": "#6B6B6B", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 1