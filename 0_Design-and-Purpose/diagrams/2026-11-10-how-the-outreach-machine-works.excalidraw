eColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["3-sequence"], "frameId": null, "roundness": null, "seed": 1, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "CLOSED\nno reply 7 days after Email 3;\nnever started again by a machine", "fontSize": 16, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "r259", "originalText": "CLOSED\nno reply 7 days after Email 3;\nnever started again by a machine", "autoResize": true, "lineHeight": 1.25}, {"id": "t260", "type": "text", "x": 120, "y": 5654, "width": 1632, "height": 20, "angle": 0, "strokeColor": "#6B6B6B", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["3-sequence"], "frameId": null, "roundness": null, "seed": 593211387, "version": 1, "versionNonce": 1278853426, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Any real reply stops the sequence and goes to Chris  -  an auto-reply is never a reply  -  a bounce stops the thread  -  weekend or US holiday = delayed to the next business day, never skipped", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Any real reply stops the sequence and goes to Chris  -  an auto-reply is never a reply  -  a bounce stops the thread  -  weekend or US holiday = delayed to the next business day, never skipped", "autoResize": true, "lineHeight": 1.25}, {"id": "r261", "type": "rectangle", "x": 100, "y": 5764, "width": 1900, "height": 360, "angle": 0, "strokeColor": "#C9C2B0", "backgroundColor": "#F5F1E8", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["4-governs"], "frameId": null, "roundness": {"type": 3}, "seed": 2067180442, "version": 1, "versionNonce": 1398948207, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "t262", "type": "text", "x": 120, "y": 5782, "width": 382, "height": 32, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["4-governs"], "frameId": null, "roundness": null, "seed": 1537862766, "version": 1, "versionNonce": 155668350, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "4 - WHAT GOVERNS EVERY STEP", "fontSize": 24, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "4 - WHAT GOVERNS EVERY STEP", "autoResize": true, "lineHeight": 1.25}, {"id": "r263", "type": "rectangle", "x": 140, "y": 5834, "width": 586.6666666666666, "height": 250, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#FFDE59", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["4-governs"], "frameId": null, "roundness": {"type": 3}, "seed": 1269149604, "version": 1, "versionNonce": 1301771097, "isDeleted": false, "boundElements": [{"id": "1bd681cfb312445689ec", "type": "text"}], "updated": 1, "link": null, "locked": false}, {"id": "1bd681cfb312445689ec", "type": "text", "x": 275.8333333333333, "y": 5874.625, "width": 315.0, "height": 168.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["4-governs"], "frameId": null, "roundness": null, "seed": 1, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "THE 8 NON-NEGOTIABLES (the Charter)\n1. Email 1 is Chris's to send\n2. One thread per organization\n3. Do-not-contact is absolute\n4. Zero guessed addresses\n5. Email copy is frozen\n6. Gmail is the truth\n7. The night never sends\n8. Doesn't add up? Stop and hold", "fontSize": 15, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "r263", "originalText": "THE 8 NON-NEGOTIABLES (the Charter)\n1. Email 1 is Chris's to send\n2. One thread per organization\n3. Do-not-contact is absolute\n4. Zero guessed addresses\n5. Email copy is frozen\n6. Gmail is the truth\n7. The night never sends\n8. Doesn't add up? Stop and hold", "autoResize": true, "lineHeight": 1.25}, {"id": "r264", "type": "rectangle", "x": 756.6666666666666, "y": 5834, "width": 586.6666666666666, "height": 250, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#FFFFFF", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["4-governs"], "frameId": null, "roundness": {"type": 3}, "seed": 924973959, "version": 1, "versionNonce": 1890815041, "isDeleted": false, "boundElements": [{"id": "00dfda59fa36430b9d38", "type": "text"}], "updated": 1, "link": null, "locked": false}, {"id": "00dfda59fa36430b9d38", "type": "text", "x": 789.0, "y": 5884.0, "width": 522.0, "height": 150.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["4-governs"], "frameId": null, "roundness": null, "seed": 1, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "WHO DOES WHAT\nFIXED PROGRAMS (same answer every time):\nbookkeeping, routing, timing, address checks,\ntemplate filling, safety gates, 'the one next step'.\nAI HELPERS (judgment): read web pages, judge fit,\nfind people, sort replies, write the plain-English report.\nThe AI never writes email copy, never picks who\ngets emailed, and never sends anything.", "fontSize": 15, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "r264", "originalText": "WHO DOES WHAT\nFIXED PROGRAMS (same answer every time):\nbookkeeping, routing, timing, address checks,\ntemplate filling, safety gates, 'the one next step'.\nAI HELPERS (judgment): read web pages, judge fit,\nfind people, sort replies, write the plain-English report.\nThe AI never writes email copy, never picks who\ngets emailed, and never sends anything.", "autoResize": true, "lineHeight": 1.25}, {"id": "r265", "type": "rectangle", "x": 1373.3333333333333, "y": 5834, "width": 586.6666666666666, "height": 250, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#FFFFFF", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["4-governs"], "frameId": null, "roundness": {"type": 3}, "seed": 1139518792, "version": 1, "versionNonce": 1284772693, "isDeleted": false, "boundElements": [{"id": "59b8661bc6f942dd9457", "type": "text"}], "updated": 1, "link": null, "locked": false}, {"id": "59b8661bc6f942dd9457", "type": "text", "x": 1414.6666666666665, "y": 5884.0, "width": 504.0, "height": 150.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["4-governs"], "frameId": null, "roundness": null, "seed": 1, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "THE GUIDING DOCUMENTS\nCHARTER - why it exists, what it must never become\nRULEBOOK - the rules; changes only from Chris\nVOCABULARY - the words\nSETTINGS FILE - every number, one block per machine\nRULINGS LOG - questions for Chris, his answers\nCAPA LOG - what went wrong, the fix, the prevention\nIf a change does not trace to one of these, it is drift.", "fontSize": 15, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "r265", "originalText": "THE GUIDING DOCUMENTS\nCHARTER - why it exists, what it must never become\nRULEBOOK - the rules; changes only from Chris\nVOCABULARY - the words\nSETTINGS FILE - every number, one block per machine\nRULINGS LOG - questions for Chris, his answers\nCAPA LOG - what went wrong, the fix, the prevention\nIf a change does not trace to one of these, it is drift.", "autoResize": true, "lineHeight": 1.25}], "appState": {"viewBackgroundColor": "#ffffff", "gridSize": null}, "files": {}}