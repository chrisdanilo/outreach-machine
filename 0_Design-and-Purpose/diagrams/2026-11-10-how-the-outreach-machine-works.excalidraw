ll, "locked": false, "text": "FIT?", "fontSize": 11, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "d164", "originalText": "FIT?", "autoResize": true, "lineHeight": 1.25}, {"id": "t165", "type": "text", "x": 582.0, "y": 2645, "width": 991, "height": 65, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["PHASE 3  -  QUALIFY, ROUTE, TIME"], "frameId": null, "roundness": null, "seed": 1748133812, "version": 1, "versionNonce": 703144546, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "FIT: a quote found on the org's own live page must pass its ICP test (doubtful = draft but flag).\nROUTE: runs its own conference with an outside keynote -> OM-2; everything else -> OM-1.\nTIME (OM-2): outreach opens 6 months before the event; silent inside 3 months; too close -> next year.", "fontSize": 17, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "FIT: a quote found on the org's own live page must pass its ICP test (doubtful = draft but flag).\nROUTE: runs its own conference with an outside keynote -> OM-2; everything else -> OM-1.\nTIME (OM-2): outreach opens 6 months before the event; silent inside 3 months; too close -> next year.", "autoResize": true, "lineHeight": 1.25}, {"id": "r166", "type": "rectangle", "x": 576.0, "y": 2724, "width": 948, "height": 56, "angle": 0, "strokeColor": "#C2410C", "backgroundColor": "#FFFFFF", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 85, "groupIds": ["PHASE 3  -  QUALIFY, ROUTE, TIME"], "frameId": null, "roundness": {"type": 3}, "seed": 208249220, "version": 1, "versionNonce": 1050419583, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "t167", "type": "text", "x": 590.0, "y": 2731, "width": 9